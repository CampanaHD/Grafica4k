# Nagano — copie para .env SOMENTE no servidor. Nunca compartilhe o arquivo preenchido.
PORT=3000
NODE_ENV=development
# Ambiente local fica restrito a este computador por padrão.
HOST=127.0.0.1

# Primeira instalação SEM banco anterior. Remova a senha e o PIN após criar a conta.
# Bancos existentes preservam a conta e não precisam destas variáveis.
NAGANO_INITIAL_EMAIL=
NAGANO_INITIAL_PASSWORD=
NAGANO_INITIAL_PIN=

# Origem exata, sem caminho. Produção exige https://seu-dominio.
APP_PUBLIC_URL=http://localhost:3000
# Ative apenas depois de configurar e testar SMTP. Em produção é obrigatório.
SECURITY_EMAIL_REQUIRED=false

# Gmail: verificação em 2 etapas + SENHA DE APP, nunca a senha habitual.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile — widget Managed. Site key pública; secret só no servidor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost
# IPs/rede do proxy HTTPS real; vazio quando não existe proxy.
TRUSTED_PROXY_IPS=

# Integrações existentes, opcionais. Segredos permanecem no servidor.
NOTION_API_TOKEN=
NOTION_DATABASE_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v22.0
META_DEFAULT_TEMPLATE_LANGUAGE=pt_BR
META_DEFAULT_COUNTRY_CODE=55
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
FUTURA_MARKUP_MULTIPLIER=2.00
FUTURA_AUTO_REFRESH_MINUTES=1440
