# Modelo público. Preencha diretamente no servidor; não envie segredos no ZIP.
NAGANO_DOMAIN=seu-dominio.example
PORT=3000
HOST=127.0.0.1
PRINTSHOP_DATA_DIR=/var/lib/nagano/data
BACKUP_DIR=/var/lib/nagano/backups
BACKUP_KEY_FILE=/var/lib/nagano/keys/backup.key
TRUSTED_PROXY_IPS=
NODE_ENV=production
APP_ENV=production
APP_PUBLIC_URL=https://seu-dominio.example
SECURITY_EMAIL_REQUIRED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=seu-dominio.example
# Set only for an entirely new installation; leave blank when migrating existing users.
NAGANO_INITIAL_EMAIL=
NAGANO_INITIAL_PASSWORD=
NAGANO_INITIAL_PIN=
# Optional: a mounted remote volume, physically outside the application host.
BACKUP_MIRROR_DIR=
